#!/bin/bash
# vme-stack EE entrypoint. Code location:
#   /vme-stack-hotfix not mounted       -> the image's code
#   /vme-stack-hotfix mounted and empty -> copy the image's code into it, use it
#   /vme-stack-hotfix mounted with code -> use it as it is (nothing copied)
set -e
IMAGE_CODE=/opt/vme-stack/code
HOTFIX=/vme-stack-hotfix
CODE=$IMAGE_CODE

if [ -d "$HOTFIX" ]; then
    if [ -z "$(ls -A "$HOTFIX")" ]; then
        cp -a "$IMAGE_CODE"/. "$HOTFIX"/
        echo "$VME_STACK_VERSION" > "$HOTFIX/VERSION"
        echo "vme-stack $VME_STACK_VERSION: image code copied to $HOTFIX (edit it on the host)" >&2
    fi
    CODE=$HOTFIX
    echo "vme-stack $VME_STACK_VERSION: using HOTFIX code from $HOTFIX (based on $(cat "$HOTFIX/VERSION" 2>/dev/null || echo unknown))" >&2
else
    echo "vme-stack $VME_STACK_VERSION" >&2
fi

# Run logs and VME_STACK_DEBUG support bundles go to /logs when it is mounted
# (e.g. -v $PWD/logs:/logs); without it they stay in the container.
if [ -z "${VME_STACK_LOG_DIR:-}" ] && [ -d /logs ]; then
    if [ -w /logs ]; then
        export VME_STACK_LOG_DIR=/logs
    else
        echo "vme-stack: /logs is mounted but not writable for uid $(id -u); logs stay in the container" >&2
    fi
fi

cd "$CODE"
export ANSIBLE_CONFIG="$CODE/ansible.cfg"
# The EE entrypoint (user/passwd handling of ansible-runner images) under dumb-init;
# every command goes through tools/vme_stack_run.py (run log, VME_STACK_DEBUG);
# a hotfix directory from an older image has none: then the image's.
RUNNER="$CODE/tools/vme_stack_run.py"
[ -f "$RUNNER" ] || RUNNER="$IMAGE_CODE/tools/vme_stack_run.py"
exec /opt/builder/bin/entrypoint dumb-init /usr/bin/python3.12 "$RUNNER" "$@"
